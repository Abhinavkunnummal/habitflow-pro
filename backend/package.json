{
  "name": "habitflow-pro-backend",
  "version": "1.0.0",
  "description": "Production REST API for HabitFlow Pro habit tracking application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'); try{fs.cpSync('dist', 'src/dist', {recursive:true})}catch(e){}; try{fs.cpSync('dist', '../dist', {recursive:true})}catch(e){}\"",
    "start": "node -e \"const fs=require('fs'); const file = fs.existsSync('dist/server.js') ? './dist/server.js' : fs.existsSync('backend/dist/server.js') ? './backend/dist/server.js' : fs.existsSync('../dist/server.js') ? '../dist/server.js' : './src/dist/server.js'; require(file);\"",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "habitflow",
    "habits",
    "tracker",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "HabitFlow Pro Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3"
  }
}
